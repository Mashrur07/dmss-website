/* ===== LIVELY CTA PARTICLES ===== */
.cta-particle {
    position: absolute;
    background: rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    pointer-events: none;
    filter: blur(1px);
    animation: floatLively 8s infinite ease-in-out;
}

@keyframes floatLively {
    0% {
        transform: translate(0, 0) scale(1);
        opacity: 0.3;
    }
    25% {
        transform: translate(20px, -20px) scale(1.2);
        opacity: 0.6;
    }
    50% {
        transform: translate(40px, 10px) scale(1.5);
        opacity: 0.8;
    }
    75% {
        transform: translate(10px, 30px) scale(1.1);
        opacity: 0.5;
    }
    100% {
        transform: translate(0, 0) scale(1);
        opacity: 0.3;
    }
}

.cta-particle-fast {
    position: absolute;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    pointer-events: none;
    filter: blur(2px);
    animation: floatFast 4s infinite ease-in-out;
}

@keyframes floatFast {
    0% {
        transform: translate(0, 0) rotate(0deg) scale(1);
        opacity: 0.4;
    }
    33% {
        transform: translate(50px, -30px) rotate(120deg) scale(1.8);
        opacity: 0.9;
    }
    66% {
        transform: translate(-20px, 40px) rotate(240deg) scale(1.3);
        opacity: 0.6;
    }
    100% {
        transform: translate(0, 0) rotate(360deg) scale(1);
        opacity: 0.4;
    }
}

.cta-particle-twinkle {
    position: absolute;
    background: white;
    border-radius: 50%;
    pointer-events: none;
    box-shadow: 0 0 15px white;
    animation: twinkle 3s infinite ease-in-out;
}

@keyframes twinkle {
    0%, 100% {
        transform: scale(0.8);
        opacity: 0.3;
        box-shadow: 0 0 5px white;
    }
    50% {
        transform: scale(2);
        opacity: 1;
        box-shadow: 0 0 25px white;
    }
}

/* ===== HERO PARTICLES ===== */
.hero-particle {
    position: absolute;
    background: rgba(15, 118, 110, 0.2);
    border-radius: 50%;
    pointer-events: none;
    filter: blur(2px);
    animation: heroFloat 10s infinite ease-in-out;
}

@keyframes heroFloat {
    0% {
        transform: translate(0, 0) rotate(0deg) scale(1);
    }
    20% {
        transform: translate(30px, -20px) rotate(72deg) scale(1.3);
    }
    40% {
        transform: translate(50px, 20px) rotate(144deg) scale(1.6);
    }
    60% {
        transform: translate(20px, 50px) rotate(216deg) scale(1.4);
    }
    80% {
        transform: translate(-20px, 30px) rotate(288deg) scale(1.2);
    }
    100% {
        transform: translate(0, 0) rotate(360deg) scale(1);
    }
}

.hero-particle-slow {
    position: absolute;
    background: rgba(15, 118, 110, 0.15);
    border-radius: 50%;
    pointer-events: none;
    filter: blur(3px);
    animation: heroFloatSlow 15s infinite ease-in-out;
}

@keyframes heroFloatSlow {
    0% {
        transform: translate(0, 0) scale(1);
        opacity: 0.2;
    }
    25% {
        transform: translate(40px, -30px) scale(1.4);
        opacity: 0.5;
    }
    50% {
        transform: translate(80px, 20px) scale(1.8);
        opacity: 0.3;
    }
    75% {
        transform: translate(30px, 60px) scale(1.2);
        opacity: 0.4;
    }
    100% {
        transform: translate(0, 0) scale(1);
        opacity: 0.2;
    }
}

