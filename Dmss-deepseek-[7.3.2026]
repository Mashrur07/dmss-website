/* ===== RESET & VARIABLES ===== */
:root {
    --primary: #0F766E;
    --primary-dark: #0a5c55;
    --primary-light: #14B8A6;
    --secondary: #1F2933;
    --accent: #0F766E;
    --accent-light: #d4f0ed;
    --light: #F9FAFB;
    --dark: #111827;
    --gray: #6B7280;
    --success: #10B981;
    --gradient: linear-gradient(135deg, var(--primary), var(--primary-light));
    --gradient-accent: linear-gradient(135deg, var(--primary), var(--primary-dark));
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    --shadow-xl: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    font-family: 'Playfair Display', serif;
    color: var(--dark);
    line-height: 1.6;
    overflow-x: hidden;
    background: var(--light);
    position: relative;
}

.zaslia-font {
    font-family: 'Zaslia', serif !important;
}

/* ===== CONTAINER ===== */
.container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ===== HEADER ===== */
header {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 40px);
    max-width: 1280px;
    padding: 12px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-radius: 50px;
    box-shadow: var(--shadow-lg);
    z-index: 1000;
    animation: slideDown 1s ease;
    border: 1px solid rgba(15, 118, 110, 0.1);
}

@keyframes slideDown {
    from {
        transform: translate(-50%, -100%);
        opacity: 0;
    }
    to {
        transform: translate(-50%, 0);
        opacity: 1;
    }
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
}

.logo-img {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    object-fit: cover;
    transition: var(--transition);
}

.brand:hover .logo-img {
    transform: scale(1.05) rotate(5deg);
    box-shadow: var(--shadow-md);
}

.brand-text {
    display: flex;
    flex-direction: column;
}

.brand h1 {
    font-size: 1.9rem;
    color: var(--primary);
    line-height: 1.2;
    letter-spacing: 1px;
}

.tagline {
    font-size: 0.7rem;
    color: var(--gray);
    letter-spacing: 0.5px;
}

/* ===== MENU TOGGLE ===== */
.menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
    z-index: 1001;
}

.menu-toggle span {
    width: 30px;
    height: 2px;
    background: var(--primary);
    transition: var(--transition);
}

/* ===== NAVIGATION ===== */
nav {
    display: flex;
    gap: 30px;
}

nav a {
    position: relative;
    font-weight: 600;
    color: var(--dark);
    padding: 5px 0;
    transition: var(--transition);
    text-decoration: none;
}

nav a:hover {
    color: var(--primary);
    transform: translateY(-2px);
}

nav a.active {
    color: var(--primary);
}

/* ===== HERO SECTION ===== */
.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #f0f9ff, #e6f7f5);
}

.hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 30% 50%, rgba(15, 118, 110, 0.03) 0%, transparent 30%),
                radial-gradient(circle at 70% 50%, rgba(15, 118, 110, 0.03) 0%, transparent 30%);
    animation: rotate 60s linear infinite;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.hero-particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
}

.hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    padding: 0 20px;
    animation: fadeUpScale 1.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes fadeUpScale {
    0% {
        opacity: 0;
        transform: translateY(50px) scale(0.95);
    }
    100% {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.hero-badge {
    display: inline-block;
    padding: 8px 24px;
    background: linear-gradient(135deg, rgba(15, 118, 110, 0.1), rgba(15, 118, 110, 0.1));
    color: var(--primary);
    border-radius: 30px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 2px;
    margin-bottom: 25px;
    backdrop-filter: blur(5px);
    border: 1px solid rgba(15, 118, 110, 0.2);
}

.hero h1 {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    line-height: 1.2;
    margin-bottom: 25px;
    color: var(--dark);
}

.hero .highlight {
    color: var(--primary);
    position: relative;
    font-weight: 700;
}

.hero-description {
    font-size: clamp(1rem, 4vw, 1.2rem);
    color: var(--gray);
    max-width: 700px;
    margin: 0 auto 35px;
}

.hero-cta {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
}

/* ===== BUTTONS ===== */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 35px;
    border-radius: 40px;
    font-weight: 600;
    transition: var(--transition);
    cursor: pointer;
    border: none;
    font-size: 1rem;
    position: relative;
    overflow: hidden;
    letter-spacing: 0.5px;
    text-decoration: none;
}

.btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transform: translate(-50%, -50%);
    transition: width 0.8s, height 0.8s;
}

.btn:hover::before {
    width: 400px;
    height: 400px;
}

.btn-primary {
    background: var(--gradient);
    color: white;
    box-shadow: 0 10px 20px rgba(15, 118, 110, 0.2);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(15, 118, 110, 0.3);
}

.btn-outline {
    background: transparent;
    color: var(--primary);
    border: 2px solid var(--primary);
    text-decoration: none;
}

.btn-outline:hover {
    background: var(--primary);
    color: white;
    transform: translateY(-3px);
}

.btn-light {
    background: white;
    color: var(--primary);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    text-decoration: none;
}

.btn-outline-light {
    background: transparent;
    color: white;
    border: 2px solid white;
    text-decoration: none;
}

.btn-outline-light:hover {
    background: white;
    color: var(--primary);
    transform: translateY(-3px);
}

.btn-block {
    display: flex;
    width: 100%;
    justify-content: center;
}

.btn-large {
    padding: 16px 40px;
    font-size: 1.1rem;
}

/* ===== SECTIONS ===== */
.section {
    padding: 100px 0;
    position: relative;
    overflow: hidden;
}

.bg-light {
    background: linear-gradient(135deg, #f8fafc, #f1f5f9);
}

.section-header {
    text-align: center;
    margin-bottom: 70px;
    position: relative;
    z-index: 2;
}

.section-subtitle {
    display: inline-block;
    color: var(--primary);
    font-weight: 600;
    letter-spacing: 3px;
    margin-bottom: 15px;
    font-size: 0.9rem;
    text-transform: uppercase;
}

.section-title {
    font-size: clamp(2rem, 6vw, 3rem);
    color: var(--dark);
    margin-bottom: 20px;
    position: relative;
}

.section-divider {
    width: 100px;
    height: 3px;
    background: var(--gradient);
    margin: 0 auto;
    border-radius: 2px;
    position: relative;
}

.section-divider::before,
.section-divider::after {
    content: '';
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--primary);
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
}

.section-divider::before {
    left: -10px;
}

.section-divider::after {
    right: -10px;
}

/* ===== CARDS GRID ===== */
.cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 35px;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.card {
    background: white;
    padding: 45px 35px;
    border-radius: 24px;
    box-shadow: var(--shadow-md);
    transition: var(--transition-slow);
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(40px);
    border: 1px solid rgba(15, 118, 110, 0.1);
}

.card::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 70% 30%, rgba(15, 118, 110, 0.02), transparent 50%);
    pointer-events: none;
    z-index: -1;
}

.card.visible {
    opacity: 1;
    transform: translateY(0);
}

.card:hover {
    transform: translateY(-12px);
    box-shadow: var(--shadow-xl);
    border-color: rgba(15, 118, 110, 0.3);
}

.card-icon {
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, rgba(15, 118, 110, 0.1), rgba(15, 118, 110, 0.1));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    border: 1px solid rgba(15, 118, 110, 0.2);
    transition: var(--transition);
}

.card:hover .card-icon {
    transform: scale(1.1) rotate(5deg);
    background: var(--gradient);
}

.card:hover .card-icon i {
    color: white;
}

.card-icon i {
    font-size: 30px;
    color: var(--primary);
    transition: var(--transition);
}

.card h3 {
    font-size: 1.6rem;
    margin-bottom: 15px;
    color: var(--dark);
    font-weight: 600;
}

.card p {
    color: var(--gray);
    line-height: 1.8;
}

.card-shine {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: rotate(45deg);
    animation: shine 8s infinite;
    pointer-events: none;
}

@keyframes shine {
    0% {
        transform: translateX(-100%) rotate(45deg);
    }
    20%, 100% {
        transform: translateX(100%) rotate(45deg);
    }
}

/* ===== PROGRAM CARDS SPECIAL BACKGROUND ===== */
#programs {
    position: relative;
    background: linear-gradient(135deg, #f0f9f5, #e6f3ef);
}

#programs::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 10% 20%, rgba(15, 118, 110, 0.03) 0%, transparent 30%),
        radial-gradient(circle at 90% 70%, rgba(15, 118, 110, 0.03) 0%, transparent 30%),
        repeating-linear-gradient(45deg, rgba(15, 118, 110, 0.01) 0px, rgba(15, 118, 110, 0.01) 2px, transparent 2px, transparent 10px);
    pointer-events: none;
    z-index: 0;
}

#programs .card {
    backdrop-filter: blur(5px);
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(15, 118, 110, 0.15);
}

#programs .card:hover {
    background: white;
}

/* ===== IMPACT SHOWCASE ===== */
.impact-showcase {
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.impact-showcase::before {
    content: '';
    position: absolute;
    top: -20px;
    left: -20px;
    right: -20px;
    bottom: -20px;
    background: 
        radial-gradient(circle at 30% 40%, rgba(15, 118, 110, 0.02) 0%, transparent 30%),
        radial-gradient(circle at 70% 60%, rgba(15, 118, 110, 0.02) 0%, transparent 30%);
    pointer-events: none;
    z-index: 0;
}

.impact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
    margin-bottom: 30px;
}

.impact-item {
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: var(--shadow-md);
    display: flex;
    gap: 20px;
    align-items: flex-start;
    transition: var(--transition);
    border: 1px solid rgba(15, 118, 110, 0.1);
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(30px);
}

.impact-item.visible {
    opacity: 1;
    transform: translateY(0);
}

.impact-item:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
    border-color: rgba(15, 118, 110, 0.3);
}

.impact-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, rgba(15, 118, 110, 0.1), rgba(15, 118, 110, 0.1));
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: var(--primary);
    flex-shrink: 0;
}

.impact-content {
    flex: 1;
}

.impact-amount-badge {
    display: inline-block;
    padding: 4px 12px;
    background: var(--gradient);
    color: white;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 10px;
}

.impact-content h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
    color: var(--dark);
}

.impact-content p {
    color: var(--gray);
    font-size: 0.95rem;
    margin-bottom: 15px;
    line-height: 1.6;
}

.impact-bar {
    width: 100%;
    height: 6px;
    background: rgba(15, 118, 110, 0.1);
    border-radius: 3px;
    overflow: hidden;
}

.impact-progress {
    height: 100%;
    background: var(--gradient);
    border-radius: 3px;
    animation: progressPulse 2s infinite;
}

@keyframes progressPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}

.impact-note {
    text-align: center;
    padding: 20px;
    background: linear-gradient(135deg, rgba(15, 118, 110, 0.05), rgba(15, 118, 110, 0.05));
    border-radius: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px solid rgba(15, 118, 110, 0.2);
}

.impact-note i {
    color: var(--primary);
    font-size: 1.2rem;
}

.impact-note p {
    color: var(--dark);
    font-weight: 500;
}

/* ===== SPECIAL SECTION (RAMADAN & ZAKAT) ===== */
.special-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.special-card {
    background: white;
    padding: 45px 35px;
    border-radius: 30px;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
    transition: var(--transition-slow);
    border: 1px solid rgba(15, 118, 110, 0.1);
    opacity: 0;
    transform: translateY(40px);
}

.special-card.visible {
    opacity: 1;
    transform: translateY(0);
}

.special-card:hover {
    transform: translateY(-12px);
    box-shadow: var(--shadow-xl);
}

.ramadan-card:hover {
    border-color: var(--primary);
}

.zakat-card:hover {
    border-color: var(--primary);
}

.special-icon {
    width: 80px;
    height: 80px;
    background: var(--gradient);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    font-size: 35px;
    color: white;
    box-shadow: 0 10px 20px rgba(15, 118, 110, 0.3);
    transition: var(--transition);
}

.special-card:hover .special-icon {
    transform: scale(1.1) rotate(10deg);
}

.special-card h3 {
    font-size: 1.8rem;
    margin-bottom: 15px;
    color: var(--dark);
}

.special-card p {
    color: var(--gray);
    margin-bottom: 25px;
    line-height: 1.8;
}

.special-stats {
    display: flex;
    justify-content: space-around;
    margin-bottom: 25px;
    padding: 20px 0;
    border-top: 1px dashed rgba(15, 118, 110, 0.3);
    border-bottom: 1px dashed rgba(15, 118, 110, 0.3);
}

.stat {
    text-align: center;
}

.stat-number {
    display: block;
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--primary);
}

.stat-label {
    font-size: 0.9rem;
    color: var(--gray);
}

.zakat-calculator {
    background: rgba(15, 118, 110, 0.05);
    padding: 20px;
    border-radius: 15px;
    margin-bottom: 25px;
}

.calculator-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
}

.calculator-item:last-child {
    margin-bottom: 0;
}

.nisab-value,
.zakat-rate {
    font-weight: 700;
    color: var(--primary);
    font-size: 1.1rem;
}

.special-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 30% 50%, rgba(15, 118, 110, 0.1), transparent 70%);
    animation: glowMove 8s infinite;
    pointer-events: none;
}

@keyframes glowMove {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(-10%, -10%); }
    66% { transform: translate(10%, 10%); }
}

/* ===== MEMBERSHIP CARDS ===== */
#membership {
    position: relative;
    background: linear-gradient(135deg, #e8f3f0, #dcebe7);
    overflow: hidden;
}

#membership::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    background: 
        radial-gradient(circle at 20% 30%, rgba(15, 118, 110, 0.04) 0%, transparent 40%),
        radial-gradient(circle at 80% 70%, rgba(15, 118, 110, 0.04) 0%, transparent 40%),
        repeating-linear-gradient(45deg, rgba(15, 118, 110, 0.01) 0px, rgba(15, 118, 110, 0.01) 2px, transparent 2px, transparent 10px);
    pointer-events: none;
    z-index: 0;
}

.membership-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 40px;
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.membership-card {
    background: white;
    padding: 50px 40px;
    border-radius: 30px;
    box-shadow: var(--shadow-lg);
    transition: var(--transition-slow);
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(40px);
    border: 1px solid rgba(15, 118, 110, 0.1);
}

.membership-card.visible {
    opacity: 1;
    transform: translateY(0);
}

.membership-card.featured {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    transform: scale(1.05);
    border: 1px solid var(--primary-light);
}

.membership-card.featured h3,
.membership-card.featured p,
.membership-card.featured .membership-features li {
    color: white;
}

.membership-card.featured .membership-icon i {
    color: white;
}

.membership-card.featured .btn-primary {
    background: white;
    color: var(--primary);
}

.membership-card.featured .btn-primary:hover {
    background: var(--primary-light);
    color: white;
}

.membership-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 6px 18px;
    background: var(--gradient);
    border-radius: 25px;
    font-size: 0.8rem;
    font-weight: 600;
    color: white;
}

.membership-card.featured .membership-badge {
    background: white;
    color: var(--primary);
}

.membership-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, rgba(15, 118, 110, 0.1), rgba(15, 118, 110, 0.1));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    border: 1px solid rgba(15, 118, 110, 0.2);
}

.membership-card.featured .membership-icon {
    background: rgba(255, 255, 255, 0.2);
}

.membership-icon i {
    font-size: 35px;
    color: var(--primary);
}

.membership-card h3 {
    font-size: 1.8rem;
    margin-bottom: 15px;
}

.membership-features {
    list-style: none;
    margin: 25px 0;
}

.membership-features li {
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.membership-features i {
    color: var(--primary);
}

.membership-card.featured .membership-features i {
    color: white;
}

/* Apply Now Button Animation */
.apply-btn {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
}

.apply-btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.apply-btn:hover::after {
    width: 300px;
    height: 300px;
}

.apply-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 15px 30px rgba(15, 118, 110, 0.4);
}

.card-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
    animation: cardGlow 8s infinite;
    pointer-events: none;
}

@keyframes cardGlow {
    0%, 100% { transform: translate(-30%, -30%); }
    50% { transform: translate(30%, 30%); }
}

/* ===== DONATION SECTION ===== */
#donation {
    position: relative;
    background: linear-gradient(135deg, #f5fbf9, #ecf5f2);
}

#donation::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
        radial-gradient(circle at 0% 0%, rgba(15, 118, 110, 0.02) 0%, transparent 50%),
        radial-gradient(circle at 100% 100%, rgba(15, 118, 110, 0.02) 0%, transparent 50%),
        linear-gradient(45deg, rgba(15, 118, 110, 0.01) 25%, transparent 25%),
        linear-gradient(-45deg, rgba(15, 118, 110, 0.01) 25%, transparent 25%);
    background-size: 50px 50px;
    pointer-events: none;
    z-index: 0;
}

.donation-wrapper {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
}

.donation-card {
    background: white;
    border-radius: 30px;
    padding: 45px;
    box-shadow: var(--shadow-xl);
    border: 1px solid rgba(15, 118, 110, 0.1);
    transition: var(--transition);
    opacity: 0;
    transform: translateY(40px);
}

.donation-card.visible {
    opacity: 1;
    transform: translateY(0);
}

.donation-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(15, 118, 110, 0.15);
    border-color: rgba(15, 118, 110, 0.3);
}

.donation-header {
    text-align: center;
    margin-bottom: 35px;
}

.donation-header h3 {
    font-size: 2rem;
    color: var(--dark);
    margin-bottom: 10px;
}

.donation-header p {
    color: var(--gray);
}

/* Amount Presets */
.amount-presets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 30px;
}

.amount-btn {
    background: linear-gradient(135deg, #f8fafc, #f1f5f9);
    border: 2px solid transparent;
    border-radius: 15px;
    padding: 18px 10px;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    position: relative;
    overflow: hidden;
    border: none;
}

.amount-btn.active {
    background: var(--gradient);
    border-color: var(--primary);
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
}

.amount-btn.active .amount-value,
.amount-btn.active .amount-label {
    color: white;
}

.amount-value {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--dark);
    transition: var(--transition);
}

.amount-label {
    font-size: 0.8rem;
    color: var(--gray);
    transition: var(--transition);
}

/* Custom Amount */
.custom-amount-wrapper {
    margin-bottom: 30px;
}

.custom-amount-wrapper label {
    display: block;
    margin-bottom: 10px;
    font-weight: 600;
    color: var(--dark);
}

.custom-amount-input {
    position: relative;
